<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exacte alarms -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Full-screen intent -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Special-use foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeLock">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TimeLock"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- Lock Activity -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Lock Receiver -->
        <receiver
            android:name=".LockReceiver"
            android:exported="false" />

        <!-- Unlock Receiver -->
        <receiver
            android:name=".UnlockReceiver"
            android:exported="false" />

        <!-- TimeLock achtergrondservice -->
        <service
            android:name=".TimeLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <!-- Uitleg waarom deze special-use service nodig is -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Time-based device lock and screen management" />

        </service>

    </application>

</manifest>